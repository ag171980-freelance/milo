APP_ENV=local
APP_DEBUG=true

# 32 bytes en base64. Generar con: php tools/generar-clave.php
# Si se pierde, los tokens de Mercado Pago guardados dejan de servir
# (cada local tendría que volver a cargar el suyo).
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=copiafacil
DB_USER=root
DB_PASS=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONT_URL=http://localhost:5173
# URL pública https de esta API (para webhooks de Mercado Pago). Vacío en local.
API_PUBLIC_URL=

# «Conectar con Mercado Pago» (OAuth): credenciales de LA aplicación de la
# plataforma (Mercado Pago Developers → Tus integraciones). Vacías: el panel
# sólo permite pegar el access token a mano.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# https y EXACTA a la configurada en la app. Por defecto: API_PUBLIC_URL/oauth/mercadopago/callback
MP_REDIRECT_URI=
# Activar PKCE también en la app de Mercado Pago (recomendado). Si no, false.
MP_PKCE=true
# true mientras probás con usuarios de prueba.
MP_OAUTH_TEST=false

# true sólo en desarrollo: deja pagar sin Mercado Pago a los locales sin token.
ALLOW_FAKE_PAYMENTS=true

# Dónde se guardan los archivos. Tiene que quedar FUERA de public/.
# STORAGE_DIR=/var/copiafacil/uploads
MAX_UPLOAD_MB=25
FILE_RETENTION_HOURS=24
FILE_MAX_HOURS=72

TERMS_VERSION=2026-11

# Aviso por mail de cada solicitud de demo (usa mail() del servidor).
DEMO_NOTIFY_EMAIL=
